{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dex",
  "version": "0.3.1",
  "identifier": "dev.dex.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecars"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dex",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Dex",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Terminal workspace multiplexer for multi-agent coding",
    "longDescription": "Dex runs several Claude Code agents side by side in one window, with shared context, worktrees, and a CLI they can drive.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "upgradeCode": "43840DE1-01B8-4C10-9984-175A26C35B1A",
        "fragmentPaths": ["wix/dex.wxs"],
        "componentGroupRefs": ["DexSetup"]
      }
    }
  }
}
