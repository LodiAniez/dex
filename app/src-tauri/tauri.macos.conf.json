{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/stage-macos-sidecars.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dex",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/dex": "macos/dex",
        "MacOS/dex-mcp": "macos/dex-mcp",
        "Resources/skills/dex-agentic/SKILL.md": "../../skills/dex-agentic/SKILL.md"
      }
    }
  }
}
